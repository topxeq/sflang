// Sflang GUI 代码编辑器
// ==================================
// 一个用 Sflang 自身实现的代码编辑器，支持语法高亮、运行、快速求值、打开/保存。
// 用法：sf examples/showcase/sf_editor.sf [文件路径] [--debug]
//       --debug 开启调试：IPC 消息、handler 异常、前端 JS 错误都会
//       打印到控制台并记录到 temp/sf_editor_debug.log

// ---- 工具函数 ----

/// escapeJS 转义字符串中的特殊字符，使其可安全嵌入 JS 单引号字符串字面量
func escapeJS(s) {
    s = strReplace(s, "\\", "\\\\")
    s = strReplace(s, "'", "\\'")
    s = strReplace(s, "\n", "\\n")
    s = strReplace(s, "\r", "")
    return s
}

// ---- 调试模式（--debug） ----
// 所有调试信息同时输出到控制台和 temp/sf_editor_debug.log
var debugMode = false
var dbgLogFile = "temp/sf_editor_debug.log"

/// dbg 输出调试日志：仅 --debug 时生效；带时间戳，控制台 + 日志文件双写
func dbg(msg) {
    if !debugMode { return }
    var line = "[dbg " + getNowStr() + "] " + toStr(msg)
    pln(line)
    appendFile(dbgLogFile, line + "\n")
}

// ---- 临时文件和 sf.exe 路径 ----
var tempFile = "temp/.sf_editor_tmp.sf"
var sfExe = ""
var langRefB64 = ""
var xtermJsB64 = ""
var xtermCssB64 = ""
var xtermFitB64 = ""

// ---- SSH 集成全局状态 ----
// xterm 三件套解码后的源码（启动时 loadXtermAssets 填充，避免每次开终端都解压）
var xtermJsSrc = ""
var xtermCssSrc = ""
var xtermFitSrc = ""
// SSH 服务器配置数组（启动时 loadSshServers 加载；元素是 map）
var sshServers = []
// 当前激活的服务器名（字符串）
var sshActiveName = ""
// 当前 PTY 会话 Native 对象（sshShellOpen 返回值；SSHTTY_OPEN/Write/Resize/Close 共用）
var sshTermSessionG = undefined
// 当前 PTY 会话的 streamId（前端 onStreamData 据此过滤）
var sshTermStreamIdG = 0

// 查找 sf 可执行文件路径
func findSfExe() {
    // 用 getOsArgs()[0] 获取 sf.exe 的完整路径
    var osArgs = getOsArgs()
    if len(osArgs) > 0 {
        var exePath = osArgs[0]
        // Windows 下确保有 .exe 扩展名
        if !strEndsWith(exePath, ".exe") && !strEndsWith(exePath, ".sf") {
            exePath = exePath + ".exe"
        }
        // 确认不是 .sf 脚本文件
        if !strEndsWith(exePath, ".sf") {
            sfExe = exePath
            return
        }
    }
    // 尝试常见位置
    var candidates = [
        "sf",
        "./sf",
        "./sf.exe",
        "./target/release/sf",
        "./target/release/sf.exe",
    ]
    for c in candidates {
        var r = lookPath(c)
        if r != undefined && r != "" {
            sfExe = c
            return
        }
    }
    sfExe = "sf"
}

// ---- 确保临时目录存在 ----
func ensureTempDir() {
    if !fileExists("temp") {
        makeDir("temp")
    }
}

// ---- SSH 辅助函数 ----

/// loadXtermAssets 一次性解码内嵌的 xterm 三件套（gzip+base64）。
///
/// 在编辑器启动时调用，结果存入 xtermJsSrc/xtermCssSrc/xtermFitSrc 全局变量。
/// SSH 终端弹窗第一次打开时通过 LOADXTERM IPC 把这些源码注入到弹窗 DOM。
func loadXtermAssets() {
    xtermJsSrc = strFromBytes(gunzipBytes(base64Decode(xtermJsB64)))
    xtermCssSrc = strFromBytes(gunzipBytes(base64Decode(xtermCssB64)))
    xtermFitSrc = strFromBytes(gunzipBytes(base64Decode(xtermFitB64)))
}

/// loadSshServers 从 setCfgStr 持久化存储加载 SSH 服务器配置。
///
/// 注意：getCfgStr 返回的是 setCfgStr 存入时的原始 Value 类型（不会 toString）。
/// 我们在 saveSshServers 里用 setCfgStr("ssh.servers", array<map>) 直接存数组，
/// 所以这里直接拿到 array，不需要 jsonDecode。
///
/// 配置每元素是 map：
///   {name, host, port, user, authType, password, keyPath, keyPassphrase,
///    cols, rows, keepalive}
/// password / keyPassphrase 在磁盘上是 encryptText 加密后的 hex 字符串。
func loadSshServers() {
    var v = getCfgStr("ssh.servers", [])
    if isType(v, "array") {
        sshServers = v
    } else {
        sshServers = []
    }
    var a = getCfgStr("ssh.active", "")
    sshActiveName = isType(a, "string") ? a : ""
}

/// saveSshServers 把 SSH 服务器配置数组持久化。
///
/// 密码安全策略：
///   - 字段值若以 "__ENCRYPT_ME__" 开头，截取后段为明文，调 encryptText(plain, "") 加密
///   - 字段值若已是 hex（旧配置），原样保留（避免重复加密）
///   - 字段值若为空字符串，原样保留（表示未设置）
/// 保存后同步更新内存中的 sshServers 和 sshActiveName。
func saveSshServers(serversArr, activeName) {
    // 处理加密标记
    var cleaned = []
    for srv in serversArr {
        var m = srv
        // 处理 password
        var pw = m["password"]
        if isType(pw, "string") && strStartsWith(pw, "__ENCRYPT_ME__") {
            var plain = strSub(pw, len("__ENCRYPT_ME__"))
            if plain == "" {
                m["password"] = ""
            } else {
                m["password"] = encryptText(plain, "")
            }
        }
        // 处理 keyPassphrase
        var kp = m["keyPassphrase"]
        if isType(kp, "string") && strStartsWith(kp, "__ENCRYPT_ME__") {
            var plain2 = strSub(kp, len("__ENCRYPT_ME__"))
            if plain2 == "" {
                m["keyPassphrase"] = ""
            } else {
                m["keyPassphrase"] = encryptText(plain2, "")
            }
        }
        push(cleaned, m)
    }
    sshServers = cleaned
    sshActiveName = activeName
    // 直接存 array<map>（getCfgStr 会原样取回，无需 jsonEncode/Decode）
    setCfgStr("ssh.servers", cleaned)
    setCfgStr("ssh.active", activeName)
}

/// sshFindServer 按名称查找服务器配置，返回 map 或 undefined。
func sshFindServer(name) {
    for srv in sshServers {
        if srv["name"] == name {
            return srv
        }
    }
    return undefined
}

/// sshGetActiveServer 返回当前激活服务器的 map（不存在则 undefined）。
func sshGetActiveServer() {
    if sshActiveName == "" {
        return undefined
    }
    return sshFindServer(sshActiveName)
}

/// sshNamesJson 生成服务器名的 JS 数组字面量（同步给前端：下拉切换、状态显示）。
func sshNamesJson() {
    var js = "["
    var first = true
    for srv in sshServers {
        if !first { js = js + "," }
        js = js + "'" + escapeJS(toStr(srv["name"])) + "'"
        first = false
    }
    return js + "]"
}

/// sshDecryptField 解密单个加密字段。
///
/// 配置中的 password / keyPassphrase 在磁盘上是 encryptText 加密后的 hex。
/// 此函数把它们解密回明文供 SSH 内置函数使用。空串或解密失败都返回空串。
func sshDecryptField(hex) {
    if !isType(hex, "string") || hex == "" {
        return ""
    }
    var plain = decryptText(hex, "")
    if isErr(plain) {
        return ""
    }
    return plain
}

/// sshBuildArgs 构造 SSH 内置函数需要的 --host/--user/... 参数数组。
///
/// 参数 srv 是服务器配置 map（字段同 loadSshServers 注释）。
/// 返回数组形如：
///   ["--host=...", "--user=...", "--password=...", "--key=...",
///    "--port=...", "--keyPassphrase=..."]
/// 密码/口令在此处解密；密钥认证时 password 为空，密钥路径放在 --key。
func sshBuildArgs(srv) {
    var args = []
    args = appendArray(args, "--host=" + toStr(srv["host"]))
    args = appendArray(args, "--user=" + toStr(srv["user"]))
    var port = srv["port"]
    if !(isType(port, "int") || isType(port, "float")) || port == 0 {
        port = 22
    }
    args = appendArray(args, "--port=" + toStr(port))
    var authType = toStr(srv["authType"])
    // 兼容旧配置的 "auth" 字段
    if authType == "" || authType == "undefined" {
        authType = toStr(srv["auth"])
    }
    if authType == "" || authType == "undefined" {
        authType = "password"  // 默认密码认证
    }
    if authType == "key" {
        // 密钥认证：传 --key 和可选 --keyPassphrase
        args = appendArray(args, "--key=" + toStr(srv["keyPath"]))
        var pass = sshDecryptField(srv["keyPassphrase"])
        if pass != "" {
            args = appendArray(args, "--keyPassphrase=" + pass)
        }
        // 密钥认证下 password 留空（SSH 函数要求 password 或 key 至少一个）
    } else {
        // 密码认证
        var pw = sshDecryptField(srv["password"])
        args = appendArray(args, "--password=" + pw)
    }
    return args
}

// ---- GUI handler：处理来自前端的消息 ----
func onMessageImpl(msg) {
    // 解析消息类型（用 \n 分隔操作码和数据）
    var nlPos = strFind("\n", msg)
    var op = ""
    var data = ""
    if nlPos >= 0 {
        op = strSub(msg, 0, nlPos)
        data = strSub(msg, nlPos + 1)
    } else {
        op = msg
    }

    if op == "RUN" {
        // 子进程模式：写临时文件 + systemCmd 执行
        ensureTempDir()
        writeFile(tempFile, data)
        // 用分离参数调用 systemCmd（避免 cmd /C 的路径解析问题）
        var output = systemCmd(sfExe, tempFile)
        // 检查是否有错误标记
        var isError = strContains("错误", output) || strContains("error", output) || strContains("panic", output)
        guiEval(win, "showOutput('" + escapeJS(output) + "', " + toStr(isError) + ")")
        guiEval(win, "setStatus('运行完成')")
    }
    elif op == "CMDRUN" {
        // CMD 窗口运行：在新 CMD 窗口中执行脚本
        ensureTempDir()
        writeFile(tempFile, data)
        // 用多参数 systemCmdDetached：cmd /K sfExe tempFile
        // cmd 保持窗口，sfExe 执行脚本
        systemCmdDetached("cmd", "/K", sfExe, tempFile)
        guiEval(win, "setStatus('已在 CMD 窗口启动')")
    }
    elif op == "BUILD" {
        // 编译为独立可执行文件（sf --build）
        // 数据格式：第1行=当前文件路径（用于推导默认输出名），其余=脚本代码
        var nlB = strFind("\n", data)
        var curName = ""
        var codeB = data
        if nlB >= 0 {
            curName = strSub(data, 0, nlB)
            codeB = strSub(data, nlB + 1)
        }
        // 先做语法检查，编译前快速反馈（不弹对话框）
        var chk = compile(codeB)
        if isErr(chk) {
            guiEval(win, "showOutput('" + escapeJS("编译失败（语法错误）:\n" + toStr(chk)) + "', true)")
            guiEval(win, "setStatus('编译失败：语法错误')")
            return
        }
        // 从当前文件路径推导默认输出名：去目录、去 .sf 扩展名，加 .exe
        var baseName = curName
        var segs = strSplit(baseName, "/")
        if len(segs) > 0 { baseName = segs[len(segs) - 1] }
        segs = strSplit(baseName, "\\")
        if len(segs) > 0 { baseName = segs[len(segs) - 1] }
        if strEndsWith(baseName, ".sf") {
            baseName = strSub(baseName, 0, len(baseName) - 3)
        }
        if baseName == "" { baseName = "sf_build" }
        ensureTempDir()
        writeFile(tempFile, codeB)
        // 原生保存对话框选择输出路径（默认 当前名.exe；取消则中止）
        var outPath = saveFileDialog(baseName + ".exe")
        if outPath == undefined {
            guiEval(win, "setStatus('已取消编译')")
            return
        }
        var output = systemCmd(sfExe, "--build", tempFile, "--output", outPath)
        var isErrB = strContains(output, "错误") || strContains(output, "error")
        guiEval(win, "showOutput('" + escapeJS(output) + "', " + toStr(isErrB) + ")")
        guiEval(win, "setStatus('" + escapeJS(isErrB ? "编译失败" : "编译完成") + "')")
    }
    elif op == "CHECK" {
        // 语法检查：只编译不执行；失败时提取行号并跳转定位
        var chk = compile(data)
        if isErr(chk) {
            var chkText = toStr(chk)
            // 错误消息中行号格式："语法错误: N:"
            var errLine = -1
            var posTag = strFind(chkText, "语法错误: ")
            if posTag >= 0 {
                var i = posTag + len("语法错误: ")
                var digits = ""
                while i < len(chkText) {
                    var ch = strSub(chkText, i, 1)
                    if strContains("0123456789", ch) { digits = digits + ch } else { break }
                    i = i + 1
                }
                if digits != "" { errLine = toInt(digits) }
            }
            guiEval(win, "showOutput('" + escapeJS("语法检查未通过:\n" + chkText) + "', true)")
            if errLine > 0 {
                guiEval(win, "gotoLine(" + toStr(errLine) + ")")
                guiEval(win, "setStatus('语法错误：第 " + toStr(errLine) + " 行')")
            } else {
                guiEval(win, "setStatus('语法检查未通过')")
            }
        } else {
            guiEval(win, "showOutput('语法正确，未发现错误', false)")
            guiEval(win, "setStatus('语法正确')")
        }
    }
    elif op == "FORMAT" {
        // 自动格式化：formatCode 调整缩进/空白后写回编辑器（内容变化标记为已修改）
        var fmt = formatCode(data)
        if isErr(fmt) {
            guiEval(win, "showOutput('" + escapeJS(toStr(fmt)) + "', true)")
            guiEval(win, "setStatus('格式化失败')")
            return
        }
        if fmt == data {
            guiEval(win, "setStatus('已是规范格式，无需调整')")
            return
        }
        guiEval(win, "setEditorContent('" + escapeJS(fmt) + "')")
        var statMsg = "已格式化（" + toStr(len(strSplitLines(data))) + " 行 → " + toStr(len(strSplitLines(fmt))) + " 行）"
        guiEval(win, "setDirty(true); setStatus('" + escapeJS(statMsg) + "')")
    }
    elif op == "EVAL" {
        // 进程内模式：compile + runCode
        var c = compile(data)
        if isErr(c) {
            guiEval(win, "showOutput('" + escapeJS(toStr(c)) + "', true)")
            return
        }
        var result = runCode(c)
        if isErr(result) {
            guiEval(win, "showOutput('" + escapeJS(toStr(result)) + "', true)")
        } else {
            var out = "=> " + toStr(result)
            guiEval(win, "showOutput('" + escapeJS(out) + "', false)")
        }
        guiEval(win, "setStatus('求值完成')")
    }
    elif op == "OPENDLG" {
        // 原生文件打开对话框
        var path = openFileDialog(".sf,.txt")
        if path != undefined {
            if fileExists(path) {
                var rawBytes = readFileBytes(path)
                var detectedEnc = "UTF-8"
                var content = ""
                if !isUtf8(rawBytes) {
                    detectedEnc = "GBK"
                    content = bytesGbToUtf8Str(rawBytes)
                } else {
                    content = strFromBytes(rawBytes)
                }
                var detectedLE = "LF"
                if strContains(content, "\r\n") {
                    detectedLE = "CRLF"
                    content = strReplace(content, "\r\n", "\n")
                }
                guiEval(win, "window.__tplContent = '" + escapeJS(content) + "';")
                guiEval(win, "document.getElementById('editor').value = window.__tplContent; onEdit(); setDirty(false); currentFile='" + escapeJS(path) + "'; updateTitle(); document.getElementById('status').textContent='已打开: " + escapeJS(path) + "'; window.__tplContent=null;")
                guiEval(win, "fileEncoding='" + detectedEnc + "'; encIdx=" + (detectedEnc == "GBK" ? "1" : "0") + "; document.getElementById('encodingInfo').textContent='" + detectedEnc + "';")
                guiEval(win, "lineEnding='" + detectedLE + "'; leIdx=" + (detectedLE == "CRLF" ? "1" : "0") + "; document.getElementById('lineEndingInfo').textContent='" + detectedLE + "';")
            } else {
                guiEval(win, "showOutput('文件不存在: " + escapeJS(path) + "', true)")
            }
        } else {
            guiEval(win, "setStatus('就绪')")
        }
    }
    elif op == "SAVEDLG" {
        // 原生保存文件对话框
        var defaultName = data
        if defaultName == "" { defaultName = "untitled.sf" }
        var path = saveFileDialog(defaultName)
        if path != undefined {
            // 发回 JS 端让它组装内容并发 SAVE 请求
            guiEval(win, "saveToPath('" + escapeJS(path) + "');")
        } else {
            guiEval(win, "setStatus('就绪')")
        }
    }
    elif op == "OPEN" {
        // 读取文件
        var path = data
        if !fileExists(path) {
            guiEval(win, "showOutput('文件不存在: " + escapeJS(path) + "', true)")
            return
        }
        // 读取字节，检测编码
        var rawBytes = readFileBytes(path)
        var detectedEnc = "UTF-8"
        if !isUtf8(rawBytes) {
            detectedEnc = "GBK"
            content = bytesGbToUtf8Str(rawBytes)
        } else {
            content = strFromBytes(rawBytes)
        }
        // 检测换行符
        var detectedLE = "LF"
        if strContains(content, "\r\n") {
            detectedLE = "CRLF"
            // 统一为 LF 供编辑器显示
            content = strReplace(content, "\r\n", "\n")
        }
        guiEval(win, "setEditorContent('" + escapeJS(content) + "')")
        guiEval(win, "setFileName('" + escapeJS(path) + "')")
        // 通知前端更新编码和换行符显示
        guiEval(win, "fileEncoding='" + detectedEnc + "'; encIdx=" + (detectedEnc == "GBK" ? "1" : "0") + "; document.getElementById('encodingInfo').textContent='" + detectedEnc + "';")
        guiEval(win, "lineEnding='" + detectedLE + "'; leIdx=" + (detectedLE == "CRLF" ? "1" : "0") + "; document.getElementById('lineEndingInfo').textContent='" + detectedLE + "';")
        guiEval(win, "setStatus('已打开: " + escapeJS(path) + " [" + detectedEnc + "/" + detectedLE + "]')")
    }
    elif op == "SAVE" {
        // 解析：第1行=路径，第2行=编码，第3行=换行符，第4行起=内容
        var nl1 = strFind("\n", data)
        var nl2 = strFind("\n", strSub(data, nl1 + 1))
        var nl3 = strFind("\n", strSub(data, nl1 + nl2 + 2))
        var path = ""
        var enc = "UTF-8"
        var le = "LF"
        var content = ""
        if nl1 >= 0 {
            path = strSub(data, 0, nl1)
            var rest1 = strSub(data, nl1 + 1)
            if nl2 >= 0 {
                enc = strSub(rest1, 0, nl2)
                var rest2 = strSub(rest1, nl2 + 1)
                if nl3 >= 0 {
                    le = strSub(rest2, 0, nl3)
                    content = strSub(rest2, nl3 + 1)
                } else {
                    content = rest2
                }
            } else {
                content = rest1
            }
        } else {
            path = data
        }

        // 换行符转换
        if le == "CRLF" {
            content = strReplace(content, "\n", "\r\n")
        }

        // 编码写入
        if enc == "GBK" {
            // GBK 编码：用 strToGbkBytes 转字节后写
            var b = strToGbkBytes(content)
            writeFileBytes(path, b)
        } else {
            writeFile(path, content)
        }

        guiEval(win, "setFileName('" + escapeJS(path) + "')")
        guiEval(win, "setStatus('已保存: " + escapeJS(path) + " [" + enc + "/" + le + "]')")
    }
    elif op == "INFO" {
        var info = "Sflang Editor v1.0 | sf路径: " + sfExe + " | 临时文件: " + tempFile
        guiEval(win, "showOutput('" + escapeJS(info) + "', false)")
    }
    elif op == "SETTITLE" {
        guiSetTitle(win, data)
    }
    elif op == "HELPDLG" {
        var helpMd = "# Sflang 代码编辑器\n\n## 快捷键\n\n| 按键 | 功能 |\n|------|------|\n| F5 | 运行（子进程，完整输出）|\n| F6 | 快速求值（进程内，返回值）|\n| F7 | CMD窗口运行 |\n| Ctrl+N | 新建 |\n| Ctrl+O | 打开 |\n| Ctrl+S | 保存 |\n| Ctrl+Shift+S | 另存为 |\n| Tab | 缩进4空格 |\n\n## 状态栏\n\n- 点击 **UTF-8** 切换编码（UTF-8/GBK）\n- 点击 **LF** 切换换行符（LF/CRLF）\n\n## 更多帮助\n\n- 命令行：`sf --help`\n- 脚本内：`help()` 内置函数\n- 内置函数列表：`sf --list-builtins`\n"
        var helpHtml = renderMarkdown(helpMd)
        guiEval(win, "showHelpDialog('" + escapeJS(helpHtml) + "')")
    }
    elif op == "ABOUTDLG" {
        guiEval(win, "showAboutDialog()")
    }
    elif op == "LANGREF" {
        var md = strFromBytes(base64Decode(langRefB64))
        var html2 = renderMarkdown(md)
        guiEval(win, "showLangRef('" + escapeJS(html2) + "')")
    }
    elif op == "BUILTINS" {
        // 用 help() 获取完整分类文本，解析生成 HTML
        var helpText = help()
        var lines = strSplit(helpText, "\n")
        var bhtml = ""
        var inCategory = false
        for line in lines {
            // 分类行：== xxx（N）==
            if strStartsWith(line, "== ") {
                bhtml = bhtml + "<h2>" + line + "</h2>"
                bhtml = bhtml + "<div style='display:flex;flex-wrap:wrap;gap:4px;margin-bottom:12px;'>"
                inCategory = true
            }
            // 函数行：  funcName, funcName2, ...
            elif inCategory && strStartsWith(line, "  ") {
                var fns = strSplit(strTrim(line), ",")
                for fn in fns {
                    var fnName = strTrim(fn)
                    if fnName != "" {
                        bhtml = bhtml + "<span class='bfn' data-fn='" + fnName + "'>" + fnName + "</span>"
                    }
                }
            }
            elif inCategory && line == "" {
                bhtml = bhtml + "</div>"
                inCategory = false
            }
        }
        if inCategory { bhtml = bhtml + "</div>" }
        guiEval(win, "showBuiltins('" + escapeJS(bhtml) + "')")
    }
    elif op == "HELPFN" {
        var fn = data
        var fnHelp = help(fn)
        guiEval(win, "showFnDetail('" + escapeJS(fnHelp) + "')")
    }
    elif op == "TPL" {
        // 从 base64 内嵌数据解码模板（不依赖外部文件）
        var tplMap = {
            "hello": "Ly8gSGVsbG8gV29ybGQKcHJpbnRsbigiSGVsbG8sIFNmbGFuZyEiKQpwcmludGxuKCLkvaDlpb3vvIzkuJbnlYzvvIEiKQo=",
            "vars": "Ly8g5Y+Y6YeP5LiO5pWw5o2u57G75Z6LCnZhciBpID0gNDIKdmFyIGYgPSAzLjE0CnZhciBzID0gImhlbGxvIgp2YXIgYiA9IHRydWUKdmFyIGFyciA9IFsxLCAyLCAzXQp2YXIgb2JqID0ge25hbWU6ICJBbGljZSIsIGFnZTogMzB9CnByaW50bG4oaSwgZiwgcywgYikKcHJpbnRsbihhcnIpCnByaW50bG4ob2JqKQo=",
            "func": "Ly8g5Ye95pWw5LiO6YCS5b2SCmZ1bmMgZmliKG4pIHsKICAgIGlmIG4gPD0gMSB7IHJldHVybiBuIH0KICAgIHJldHVybiBmaWIobi0xKSArIGZpYihuLTIpCn0KCmZvciBpIDo9IDA7IGkgPCAxMDsgaSsrIHsKICAgIHByaW50bG4oImZpYigiICsgaSArICIpID0gIiArIGZpYihpKSkKfQo=",
            "interp": "Ly8g5a2X56ym5Liy5o+S5YC8CnZhciBuYW1lID0gIldvcmxkIgp2YXIgY291bnQgPSA0MgpwcmludGxuKCJIZWxsbywgJHtuYW1lfSEiKQpwcmludGxuKCJjb3VudCA9ICR7Y291bnQgKyAxfSIpCg==",
            "switch": "Ly8gc3dpdGNoIOivreWPpQp2YXIgZGF5ID0gMwpzd2l0Y2ggZGF5IHsKICAgIGNhc2UgMSB7IHByaW50bG4oIuWRqOS4gCIpIH0KICAgIGNhc2UgMiB7IHByaW50bG4oIuWRqOS6jCIpIH0KICAgIGNhc2UgMyB7IHByaW50bG4oIuWRqOS4iSIpIH0KICAgIGRlZmF1bHQgeyBwcmludGxuKCLlhbbku5YiKSB9Cn0K",
            "loop": "Ly8g5b6q546v5LiO6YGN5Y6GCnZhciBhcnIgPSBbMTAsIDIwLCAzMF0KZm9yIHYgaW4gYXJyIHsgcHJpbnRsbih2KSB9CmZvciBpLCB2IGluIGFyciB7IHByaW50bG4oaSwgdikgfQpmb3IgaSA6PSAwOyBpIDwgMzsgaSsrIHsgcHJpbnRsbihpKSB9CnZhciBtID0gbWFweyJhIjogMSwgImIiOiAyfQpmb3IgaywgdiBpbiBtIHsgcHJpbnRsbihrLCB2KSB9Cg==",
            "trycatch": "",
            "oop": "",
            "concurrency": "",
            "csvdb": "",
        }
        var name = data
        var b64 = tplMap[name]
        if b64 != undefined {
            var content = strFromBytes(base64Decode(b64))
            guiEval(win, "window.__tplContent = '" + escapeJS(content) + "';")
            guiEval(win, "document.getElementById('editor').value = window.__tplContent; onEdit(); setDirty(false); currentFile=''; document.getElementById('status').textContent='已加载: " + escapeJS(name) + "'; window.__tplContent=null;")
        } else {
            guiEval(win, "showOutput('模板未找到: " + escapeJS(name) + "', true)")
        }
    }
    // ==================== SSH 集成 IPC 分支 ====================
    elif op == "LOADXTERM" {
        // 一次性返回解码后的 xterm 三件套源码（前端注入到终端弹窗 DOM）
        guiEval(win, "window.__xtermAssets = {js:'" + escapeJS(xtermJsSrc) + "', css:'" + escapeJS(xtermCssSrc) + "', fit:'" + escapeJS(xtermFitSrc) + "'}; if(window.__onXtermLoaded)window.__onXtermLoaded();")
    }
    elif op == "SSHCFG" {
        // 返回当前 SSH 服务器配置和激活名（前端填表单）
        // password / keyPassphrase 字段不暴露明文，前端编辑时只显示掩码
        var cfgJson = jsonEncode(sshServers)
        guiEval(win, "sshCfgRender('" + escapeJS(cfgJson) + "', '" + escapeJS(sshActiveName) + "')")
    }
    elif op == "SSHCFG_SAVE" {
        // 解析 JSON 数组，处理 __ENCRYPT_ME__ 前缀后持久化
        // data 格式：JSON数组\n激活名
        var nlIdx = strFind("\n", data)
        var jsonStr = data
        var activeN = ""
        if nlIdx >= 0 {
            jsonStr = strSub(data, 0, nlIdx)
            activeN = strSub(data, nlIdx + 1)
        }
        var parsed = jsonDecode(jsonStr)
        if isErr(parsed) {
            guiEval(win, "alert('配置解析失败: " + escapeJS(toStr(parsed)) + "')")
            return
        }
        saveSshServers(parsed, activeN)
        // 同步前端全局（激活名/服务器名列表），终端与浏览器下拉立即生效
        guiEval(win, "__sshActiveName = '" + escapeJS(sshActiveName) + "'; __sshServerNames = " + sshNamesJson() + ";")
        guiEval(win, "sshCfgSaveResult(true, '已保存 " + len(sshServers) + " 个服务器')")
    }
    elif op == "SSHCFG_TEST" {
        // 测试某服务器连接：runAsync(sshRun "echo __SSH_OK__")
        var srvName = data
        var srv = sshFindServer(srvName)
        if srv == undefined {
            guiEval(win, "sshCfgTestResult(false, '服务器不存在: " + escapeJS(srvName) + "')")
            return
        }
        var args = sshBuildArgs(srv)
        // 在后台线程跑 SSH（避免阻塞 GUI）。注意 SSH 内置函数接受可变参数，
        // 所以用 ...args 把数组展开为多个参数。
        var tid = runAsync(func() {
            return sshRun(...args, "echo __SSH_OK__")
        })
        guiEval(win, "sshBindTaskId('TEST', '', " + tid + ")")
    }
    // 快速切换激活服务器（浏览器下拉等处调用）；同一时间仅一个激活
    elif op == "SSH_ACTIVATE" {
        var nameAct = data
        if sshFindServer(nameAct) == undefined {
            guiEval(win, "if(window.sshServerActivated) sshServerActivated(false, '" + escapeJS(nameAct) + "')")
            return
        }
        saveSshServers(sshServers, nameAct)
        guiEval(win, "__sshActiveName = '" + escapeJS(nameAct) + "'; __sshServerNames = " + sshNamesJson() + ";")
        guiEval(win, "if(window.sshServerActivated) sshServerActivated(true, '" + escapeJS(nameAct) + "')")
    }
    // SSH 文件操作（LIST/OPEN/SAVE/MKDIR/DELETE/RENAME）：全部通过 runAsync 异步执行
    elif op == "SSHOP" {
        // data 格式：子命令\n远程路径[ \n附加数据]
        var nl1 = strFind("\n", data)
        if nl1 < 0 {
            guiEval(win, "showOutput('SSHOP 数据格式错误', true)")
            return
        }
        var subCmd = strSub(data, 0, nl1)
        var rest = strSub(data, nl1 + 1)
        var srv = sshGetActiveServer()
        if srv == undefined {
            guiEval(win, "sshNoActiveServer('" + escapeJS(subCmd) + "')")
            return
        }
        var args = sshBuildArgs(srv)

        if subCmd == "LIST" {
            var remotePath = rest
            var tid = runAsync(func() {
                return sshListDetail(...args, "--remotePath=" + remotePath)
            })
            guiEval(win, "sshBindTaskId('LIST', '" + escapeJS(remotePath) + "', " + tid + ")")
        }
        elif subCmd == "OPEN" {
            var remotePath = rest
            // 成功时把 bytes 转成字符串返回（前端直接得到 string，无需再解码）；
            // 失败时原样返回 error，由 onAsyncResult 的 isError 标记传递
            var tid = runAsync(func() {
                var bts = sshDownloadBytes(...args, "--remotePath=" + remotePath)
                if isErr(bts) { return bts }
                return strFromBytes(bts)
            })
            guiEval(win, "sshBindTaskId('OPEN', '" + escapeJS(remotePath) + "', " + tid + ")")
        }
        elif subCmd == "SAVE" {
            // rest 格式：路径\n内容（内容可能含任意字符，包括换行）
            var nl2 = strFind("\n", rest)
            var savePath = rest
            var content = ""
            if nl2 >= 0 {
                savePath = strSub(rest, 0, nl2)
                content = strSub(rest, nl2 + 1)
            }
            var dataBytes = bytes(content)
            var tid = runAsync(func() {
                return sshUploadBytes(...args, "--remotePath=" + savePath, dataBytes)
            })
            guiEval(win, "sshBindTaskId('SAVE', '" + escapeJS(savePath) + "', " + tid + ")")
        }
        elif subCmd == "MKDIR" {
            var remotePath = rest
            var tid = runAsync(func() {
                return sshEnsureMakeDirs(...args, "--remotePath=" + remotePath)
            })
            guiEval(win, "sshBindTaskId('MKDIR', '" + escapeJS(remotePath) + "', " + tid + ")")
        }
        elif subCmd == "DELETE" {
            var remotePath = rest
            var tid = runAsync(func() {
                return sshRemove(...args, "--remotePath=" + remotePath)
            })
            guiEval(win, "sshBindTaskId('DELETE', '" + escapeJS(remotePath) + "', " + tid + ")")
        }
        elif subCmd == "RENAME" {
            // rest 格式：oldPath\nnewPath
            var nl3 = strFind("\n", rest)
            if nl3 < 0 {
                guiEval(win, "showOutput('RENAME 数据格式错误', true)")
                return
            }
            var oldP = strSub(rest, 0, nl3)
            var newP = strSub(rest, nl3 + 1)
            var tid = runAsync(func() {
                return sshMove(...args, "--remotePath=" + oldP, "--targetPath=" + newP)
            })
            guiEval(win, "sshBindTaskId('RENAME', '" + escapeJS(oldP) + "', " + tid + ")")
        }
        else {
            guiEval(win, "showOutput('未知 SSHOP 子命令: " + escapeJS(subCmd) + "', true)")
        }
    }
    // SSH PTY 终端（持久化 session 存全局变量 sshTermSessionG）
    elif op == "SSHTTY_OPEN" {
        var srvName = data
        var srv = sshFindServer(srvName)
        if srv == undefined {
            guiEval(win, "sshTtyOpenResult(0, false, '服务器不存在: " + escapeJS(srvName) + "')")
            return
        }
        // 若已有 session 先关闭
        if sshTermSessionG != undefined {
            sshShellClose(sshTermSessionG)
            sshTermSessionG = undefined
            sshTermStreamIdG = 0
        }
        var cols = srv["cols"]
        var rows = srv["rows"]
        if !(isType(cols, "int") || isType(cols, "float")) || cols == 0 { cols = 120 }
        if !(isType(rows, "int") || isType(rows, "float")) || rows == 0 { rows = 40 }
        var ttyArgs = sshBuildArgs(srv)
        ttyArgs = appendArray(ttyArgs, "--cols=" + toStr(cols))
        ttyArgs = appendArray(ttyArgs, "--rows=" + toStr(rows))
        // sshShellOpen 在主线程同步执行（需要立即拿到 session）。
        // 用 ...ttyArgs 展开为可变参数。
        var sess = sshShellOpen(...ttyArgs)
        if isErr(sess) {
            guiEval(win, "sshTtyOpenResult(0, false, '" + escapeJS(toStr(sess)) + "')")
            return
        }
        sshTermSessionG = sess
        sshTermStreamIdG = sshShellStreamId(sess)
        // 启动保活（若配置了 keepalive > 0）
        var ka = srv["keepalive"]
        if !(isType(ka, "int") || isType(ka, "float")) || ka < 0 { ka = 30 }
        if ka > 0 {
            sshShellKeepalive(sess, "--interval=" + toStr(ka))
        }
        guiEval(win, "sshTtyOpenResult(" + sshTermStreamIdG + ", true, '')")
    }
    elif op == "SSHTTY_WRITE" {
        if sshTermSessionG == undefined {
            return
        }
        sshShellWrite(sshTermSessionG, data)
    }
    elif op == "SSHTTY_RESIZE" {
        // data 格式：cols\nrows
        if sshTermSessionG == undefined {
            return
        }
        var nlR = strFind("\n", data)
        if nlR < 0 { return }
        var c = strSub(data, 0, nlR)
        var r = strSub(data, nlR + 1)
        sshShellResize(sshTermSessionG, toInt(c), toInt(r))
    }
    elif op == "SSHTTY_CLOSE" {
        if sshTermSessionG != undefined {
            sshShellClose(sshTermSessionG)
            sshTermSessionG = undefined
            sshTermStreamIdG = 0
        }
    }
}

/// onMessage IPC 统一入口：包装 onMessageImpl，提供调试日志与错误捕获。
/// - --debug 时记录每条消息（预览前 100 字符）和处理耗时
/// - handler 异常不再只打到 stderr：控制台输出 + 前端状态栏提示，
///   避免"点了没反应"却无任何线索
func onMessage(msg) {
    var preview = msg
    if len(msg) > 100 {
        preview = strSub(msg, 0, 100) + "...(" + toStr(len(msg)) + " 字节)"
    }
    dbg("IPC <- " + strReplace(preview, "\n", "\\n"))
    var t0 = now()
    var result = undefined
    try {
        result = onMessageImpl(msg)
    } catch (e) {
        pln("[sf_editor] 消息处理出错: " + toStr(e))
        dbg("IPC 异常: " + toStr(e))
        guiEval(win, "setStatus('处理出错，详见控制台/debug 日志')")
    }
    dbg("IPC ok " + toStr(now() - t0) + "ms")
    return result
}

// ---- 初始化 ----
findSfExe()
ensureTempDir()
// SSH 集成初始化：解码 xterm 资源 + 加载持久化的 SSH 配置
// 这两步是同步的，但很快（gunzip 几百 KB 的 xterm；readCfgStr 一次磁盘读）
loadXtermAssets()
loadSshServers()

// 解析命令行参数：--debug/-debug 开启调试；第一个非 -- 开头参数为预加载文件
var initFile = ""
var args = argsG
for a in args {
    if a == "--debug" || a == "-debug" {
        debugMode = true
    } elif initFile == "" && strSub(a, 0, 2) != "--" {
        initFile = a
    }
}
if debugMode {
    writeFile(dbgLogFile, "==== sf_editor 调试会话 " + getNowStr() + " ====\n")
    pln("[debug 已开启] IPC/JS 调试信息将打印到控制台并记录到 " + dbgLogFile)
    dbg("initFile = " + (initFile == "" ? "(无)" : initFile))
    dbg("sfExe = " + (sfExe == "" ? "(未定位)" : sfExe))
}

// ---- 构建 HTML ----
var html = ""
html = html + "<!DOCTYPE html><html><head><meta charset='utf-8'>"
html = html + "<style>"
// CSS 样式
html = html + "* { margin: 0; padding: 0; box-sizing: border-box; }"
html = html + "body { font-family: 'Consolas', 'Monaco', 'Courier New', monospace; background: #1e1e1e; color: #d4d4d4; height: 100vh; display: flex; flex-direction: column; }"
// 工具栏
html = html + ".toolbar { background: #252526; border-bottom: 1px solid #3c3c3c; padding: 6px 10px; display: flex; gap: 4px; align-items: center; flex-shrink: 0; }"
html = html + ".toolbar button { background: #3c3c3c; color: #d4d4d4; border: 1px solid #505050; padding: 5px 14px; border-radius: 3px; cursor: pointer; font-size: 13px; font-family: inherit; transition: background 0.15s; }"
html = html + ".toolbar button:hover { background: #505050; }"
html = html + ".toolbar button:active { background: #264f78; }"
html = html + ".toolbar button.run { background: #388e3c; border-color: #4caf50; color: #fff; }"
html = html + ".toolbar button.run:hover { background: #4caf50; }"
html = html + ".toolbar button.build { background: #6a4fb3; border-color: #8a6fd4; color: #fff; }"
html = html + ".toolbar button.build:hover { background: #7d5fc9; }"
html = html + ".toolbar button.eval { background: #1565c0; border-color: #1976d2; color: #fff; }"
html = html + ".toolbar button.eval:hover { background: #1976d2; }"
html = html + ".toolbar .sep { width: 1px; height: 22px; background: #505050; margin: 0 4px; }"
html = html + ".toolbar .title { margin-left: auto; color: #888; font-size: 12px; }"
// 编辑器区
html = html + ".editor-area { flex: 1; display: flex; overflow: hidden; position: relative; }"
html = html + ".editor-wrap { flex: 1; position: relative; overflow: hidden; display: flex; }"
// 行号列
html = html + ".gutter { background: #1e1e1e; color: #858585; padding: 10px 6px 10px 10px; text-align: right; font-size: 14px; line-height: 1.5; user-select: none; overflow: hidden; min-width: 40px; font-family: inherit; white-space: pre; flex-shrink: 0; }"
html = html + ".editor-inner { flex: 1; position: relative; overflow: hidden; }"
html = html + ".editor-inner textarea, .editor-inner pre { position: absolute; top: 0; left: 0; width: 100%; height: 100%; padding: 10px; font-family: inherit; font-size: 14px; line-height: 1.5; border: none; resize: none; outline: none; white-space: pre; overflow: auto; tab-size: 4; }"
html = html + ".editor-inner textarea { background: transparent; color: transparent; caret-color: #d4d4d4; z-index: 2; }"
html = html + ".editor-inner textarea::selection { background: #264f78; color: #fff; }"
html = html + ".editor-inner pre { background: #1e1e1e; color: #d4d4d4; z-index: 1; pointer-events: none; }"
// 高亮颜色
html = html + ".kw { color: #569cd6; }"       // 关键字 蓝
html = html + ".str { color: #ce9178; }"       // 字符串 橙
html = html + ".cmt { color: #6a9955; }"       // 注释 绿
html = html + ".num { color: #b5cea8; }"       // 数字 浅绿
html = html + ".fn { color: #dcdcaa; }"        // 函数名 黄
html = html + ".op { color: #d4d4d4; }"        // 运算符
html = html + ".bool { color: #569cd6; }"      // true/false
html = html + ".builtin { color: #4ec9b0; }"   // 内置函数 青绿
// 输出区
html = html + ".output-area { height: 220px; min-height: 80px; border-top: 2px solid #3c3c3c; display: flex; flex-direction: column; flex-shrink: 0; }"
html = html + ".output-header { background: #252526; padding: 4px 10px; font-size: 12px; color: #888; display: flex; align-items: center; }"
html = html + ".output-header button { background: none; border: none; color: #888; cursor: pointer; font-size: 12px; margin-left: auto; padding: 2px 8px; }"
html = html + ".output-header button:hover { color: #d4d4d4; }"
html = html + ".output-content { flex: 1; overflow: auto; padding: 8px 10px; font-size: 13px; line-height: 1.5; white-space: pre-wrap; word-break: break-all; }"
html = html + ".output-content.error { color: #f44747; }"
html = html + ".output-content .err-line { color: #f44747; }"
// 状态栏
html = html + ".statusbar { background: #007acc; color: #fff; padding: 3px 10px; font-size: 12px; display: flex; gap: 16px; flex-shrink: 0; }"
html = html + ".statusbar .spacer { flex: 1; }"
// 滚动条
html = html + "::-webkit-scrollbar { width: 10px; height: 10px; }"
html = html + "::-webkit-scrollbar-track { background: #1e1e1e; }"
html = html + "::-webkit-scrollbar-thumb { background: #424242; border-radius: 5px; }"
html = html + "::-webkit-scrollbar-thumb:hover { background: #555; }"
// 模板菜单项
html = html + ".tpl-item { padding: 5px 12px; cursor: pointer; font-size: 13px; color: #d4d4d4; white-space: nowrap; }"
html = html + ".tpl-item:hover { background: #264f78; }"
html = html + ".bfn { display:inline-block; background:#2d2d2d; padding:2px 8px; border-radius:3px; cursor:pointer; border:1px solid #444; margin:2px; font-size:12px; }"
html = html + ".bfn:hover { background:#264f78; }"
// SSH 配置弹窗
html = html + ".ssh-cfg { display:flex; height:100%; }"
html = html + ".ssh-cfg-left { width:35%; border-right:1px solid #3c3c3c; overflow:auto; }"
html = html + ".ssh-cfg-right { flex:1; overflow:auto; padding:12px; }"
html = html + ".ssh-form { color:#d4d4d4; font-size:13px; }"
html = html + ".ssh-field { display:flex; align-items:center; margin-bottom:8px; }"
html = html + ".ssh-field label { width:90px; color:#888; flex-shrink:0; }"
html = html + ".ssh-field input, .ssh-field select { flex:1; background:#2d2d2d; border:1px solid #505050; color:#d4d4d4; padding:4px 8px; border-radius:3px; font-family:inherit; font-size:13px; }"
html = html + ".ssh-btn { background:#3c3c3c; color:#d4d4d4; border:1px solid #505050; padding:5px 14px; border-radius:3px; cursor:pointer; font-size:13px; font-family:inherit; }"
html = html + ".ssh-btn:hover { background:#505050; }"
// SSH 文件浏览器
html = html + ".ssh-browser { display:flex; flex-direction:column; height:100%; color:#d4d4d4; }"
html = html + ".ssh-browser-bar { display:flex; gap:6px; padding:8px; border-bottom:1px solid #3c3c3c; align-items:center; flex-shrink:0; }"
html = html + ".ssh-browser-bar input { flex:1; background:#2d2d2d; border:1px solid #505050; color:#d4d4d4; padding:4px 8px; border-radius:3px; font-family:'Consolas',monospace; font-size:13px; }"
html = html + ".ssh-browser-list { flex:1; overflow:auto; padding:4px 0; }"
html = html + ".ssh-item { display:flex; align-items:center; padding:4px 12px; cursor:pointer; font-size:13px; }"
html = html + ".ssh-item:hover { background:#2a2d2e; }"
html = html + ".ssh-item.selected { background:#264f78; }"
html = html + ".ssh-item .ssh-icon { width:20px; flex-shrink:0; }"
html = html + ".ssh-item .ssh-name { flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }"
html = html + ".ssh-item .ssh-meta { color:#888; font-size:11px; margin-left:12px; flex-shrink:0; }"
html = html + ".ssh-empty { padding:20px; color:#666; text-align:center; }"
// SSH 终端
html = html + ".ssh-term { display:flex; flex-direction:column; height:100%; }"

html = html + "      var match = q == '' || tocItems[i].text.indexOf(q) >= 0;"
html = html + "      tocItems[i].el.style.display = match ? '' : 'none';"
html = html + "      tocItems[i].el.style.background = (match && q != '') ? '#37343a' : '';"
html = html + "    }"
html = html + "  };"
html = html + "}"

html = html + "var TEMPLATES = {};"
html = html + "function loadTplFile(path, name) {"
html = html + "  window.ipc.postMessage('OPEN\\n' + path);"
html = html + "}"

html = html + "function loadTpl(name) {"
html = html + "  var hasContent = document.getElementById('editor').value.trim().length > 0;"
html = html + "  if (hasContent && isDirty && !confirm('当前内容未保存，是否替换？')) return;"
html = html + "  document.getElementById('tplMenu').style.display = 'none';"
html = html + "  document.getElementById('status').textContent = '加载模板中: ' + name;"
html = html + "  var msg = 'TPL' + String.fromCharCode(10) + name;"
html = html + "  window.ipc.postMessage(msg);"
html = html + "}"
html = html + "// ==================== SSH 集成 ====================\n"
html = html + "// 通用：把 taskId 与 op/path 绑定，供 onAsyncResult 分发\n"
html = html + "function sshBindTaskId(op, path, tid) { __sshCallbacks[tid] = {op:op, path:path}; }"
html = html + "// 后端异步结果回调：根据绑定的 op 分发\n"
html = html + "window.onAsyncResult = function(tid, resultJson, isError) {"
html = html + "  var cb = __sshCallbacks[tid];"
html = html + "  if (!cb) return; delete __sshCallbacks[tid];"
html = html + "  try {"
html = html + "    if (cb.op === 'LIST') sshListResult(resultJson, isError, cb.path);"
html = html + "    else if (cb.op === 'OPEN') sshOpenResult(resultJson, isError, cb.path);"
html = html + "    else if (cb.op === 'SAVE') sshSaveResult(resultJson, isError, cb.path);"
html = html + "    else if (cb.op === 'MKDIR') sshMkdirResult(resultJson, isError, cb.path);"
html = html + "    else if (cb.op === 'DELETE') sshDeleteResult(resultJson, isError, cb.path);"
html = html + "    else if (cb.op === 'RENAME') sshRenameResult(resultJson, isError, cb.path);"
html = html + "    else if (cb.op === 'TEST') sshCfgTestResult(isError, resultJson);"
html = html + "  } catch(e) { showOutput('SSH 回调异常: ' + e.message, true); }"
html = html + "};"
html = html + "// 后端流式数据回调（SSH PTY 远端输出）\n"
html = html + "// kindNum: 0=Data, 1=Eof, 2=Error, 3=Exit(code)\n"
html = html + "window.onStreamData = function(streamId, data, kindNum, extra) {"
html = html + "  if (streamId !== __sshTermState.streamId) return;"
html = html + "  if (kindNum === 0) {"
html = html + "    if (__sshTermState.term) __sshTermState.term.write(data);"
html = html + "  } else if (kindNum === 1 || kindNum === 3) {"
html = html + "    sshTtyOnDisconnect(kindNum === 3 ? ('进程退出 code=' + extra) : '远端 EOF');"
html = html + "  } else if (kindNum === 2) {"
html = html + "    sshTtyOnDisconnect('错误: ' + data);"
html = html + "  }"
html = html + "};"
html = html + "// 通用：发送 IPC 消息（op + \\n + data）\n"
html = html + "function sshSend(op, data) {"
html = html + "  var msg = op + String.fromCharCode(10) + (data === undefined ? '' : data);"
html = html + "  window.ipc.postMessage(msg);"
html = html + "}"
html = html + "// ---- SSH 配置管理弹窗 ----\n"
html = html + "// 配置弹窗内部缓存（仅在弹窗打开期间有效；关闭时通过 SSHCFG_SAVE 持久化）\n"
html = html + "var sshCfgServersCache = []; var sshCfgActiveCache = ''; var sshCfgCurIdx = -1;"
html = html + "function doSshConfig() { sshSend('SSHCFG', ''); }"
html = html + "// 后端返回配置后渲染\n"
html = html + "function sshCfgRender(cfgJson, activeName) {"
html = html + "  var servers = [];"
html = html + "  try { servers = (typeof cfgJson === 'string') ? JSON.parse(cfgJson || '[]') : (cfgJson || []); } catch(e) {}"
html = html + "  sshCfgRenderList(servers, activeName);"
html = html + "  var cfgHtml = '<div class=\\'ssh-cfg\\'><div class=\\'ssh-cfg-left\\' id=\\'sshCfgList\\'>' + sshCfgListHtml(servers, activeName) + '</div>';"
html = html + "  cfgHtml += '<div class=\\'ssh-cfg-right\\' id=\\'sshCfgForm\\'>请选择或新增服务器</div>';"
html = html + "  cfgHtml += '</div>';"
html = html + "  cfgHtml += '<div style=\\'padding:8px;text-align:right;border-top:1px solid #3c3c3c\\'><button class=\\'ssh-btn\\' onclick=\\'sshCfgClose()\\'>关闭</button></div>';"
html = html + "  sshShowDialog('SSH 服务器配置', cfgHtml, '70%', '70%');"
html = html + "  sshCfgServersCache = servers; sshCfgActiveCache = activeName; sshCfgCurIdx = -1;"
html = html + "}"
html = html + "// 生成左侧列表 HTML（抽出共用函数避免重复）\n"
html = html + "function sshCfgListHtml(servers, activeName) {"
html = html + "  var h = '<div style=\\'padding:6px;color:#888;font-size:12px\\'>服务器列表 (' + servers.length + ')</div>';"
html = html + "  h += '<div class=\\'tpl-item\\' onclick=\\'sshCfgEditNew()\\' style=\\'color:#4caf50\\'>+ 新增服务器</div>';"
html = html + "  h += '<div style=\\'border-top:1px solid #3c3c3c;margin:4px 0\\'></div>';"
html = html + "  for (var i = 0; i < servers.length; i++) {"
html = html + "    var s = servers[i]; var isAct = (s.name === activeName);"
html = html + "    h += '<div class=\\'tpl-item\\' data-idx=\\''+i+'\\' onclick=\\'sshCfgSelect('+i+')\\' style=\\'display:flex;justify-content:space-between;\\'>';"
html = html + "    h += '<span>' + (isAct ? '★ ' : '  ') + esc(s.name || '(未命名)') + '</span>';"
html = html + "    h += '<span style=\\'color:#888;font-size:11px\\'>' + esc(s.host || '') + ':' + esc(s.port || 22) + '</span></div>';"
html = html + "  }"
html = html + "  if (servers.length === 0) h += '<div style=\\'padding:10px;color:#666\\'>暂无服务器，点击上方新增</div>';"
html = html + "  return h;"
html = html + "}"
html = html + "// 刷新左侧列表（应用/删除/激活后调用）\n"
html = html + "function sshCfgRenderList(servers, activeName) {"
html = html + "  var listEl = document.getElementById('sshCfgList');"
html = html + "  if (listEl) listEl.innerHTML = sshCfgListHtml(servers, activeName);"
html = html + "}"
html = html + "// （sshCfgServersCache 等已在上方声明，供所有 cfg 函数共享）\n"
html = html + "// 选中某个服务器：渲染编辑表单\n"
html = html + "function sshCfgSelect(idx) {"
html = html + "  if (idx < 0 || idx >= sshCfgServersCache.length) return;"
html = html + "  sshCfgCurIdx = idx;"
html = html + "  var s = sshCfgServersCache[idx];"
html = html + "  var formHtml = sshCfgFormHtml(s);"
html = html + "  document.getElementById('sshCfgForm').innerHTML = formHtml;"
html = html + "  // 更新列表的选中态\n"
html = html + "  var items = document.getElementById('sshCfgList').querySelectorAll('.tpl-item');"
html = html + "  for (var i = 0; i < items.length; i++) { items[i].style.background = ''; }"
html = html + "  var sel = document.querySelector('.tpl-item[data-idx=\\''+idx+'\\']');"
html = html + "  if (sel) sel.style.background = '#264f78';"
html = html + "}"
html = html + "function sshCfgEditNew() {"
html = html + "  var ns = {name:'新服务器', host:'', port:22, user:'root', authType:'password', password:'', keyPath:'', keyPassphrase:'', cols:120, rows:40, keepalive:30, reconnect:true};"
html = html + "  sshCfgServersCache.push(ns);"
html = html + "  sshCfgRenderList(sshCfgServersCache, sshCfgActiveCache);"
html = html + "  sshCfgSelect(sshCfgServersCache.length - 1);"
html = html + "}"
html = html + "// 生成编辑表单 HTML\n"
html = html + "function sshCfgFormHtml(s) {"
html = html + "  var authType = s.authType || 'password';"
html = html + "  var h = '<div class=\\'ssh-form\\'>';"
html = html + "  h += '<div class=\\'ssh-field\\'><label>名称</label><input id=\\'cfgName\\' value=\\'' + esc(s.name||'') + '\\'/></div>';"
html = html + "  h += '<div class=\\'ssh-field\\'><label>Host</label><input id=\\'cfgHost\\' value=\\'' + esc(s.host||'') + '\\'/></div>';"
html = html + "  h += '<div class=\\'ssh-field\\'><label>端口</label><input id=\\'cfgPort\\' value=\\'' + esc(s.port||22) + '\\'/></div>';"
html = html + "  h += '<div class=\\'ssh-field\\'><label>用户</label><input id=\\'cfgUser\\' value=\\'' + esc(s.user||'') + '\\'/></div>';"
html = html + "  h += '<div class=\\'ssh-field\\'><label>认证方式</label><select id=\\'cfgAuth\\' onchange=\\'sshCfgAuthChange()\\'><option value=\\'password\\'' + (authType==='password'?' selected':'') + '>密码</option><option value=\\'key\\'' + (authType==='key'?' selected':'') + '>密钥</option></select></div>';"
html = html + "  h += '<div class=\\'ssh-field\\' id=\\'cfgPwRow\\'><label>密码</label><input id=\\'cfgPassword\\' type=\\'password\\' placeholder=\\'留空则不修改\\'/></div>';"
html = html + "  h += '<div class=\\'ssh-field\\' id=\\'cfgKeyRow\\' style=\\'display:' + (authType==='key'?'block':'none') + '\\'><label>私钥路径</label><input id=\\'cfgKeyPath\\' value=\\'' + esc(s.keyPath||'') + '\\'/></div>';"
html = html + "  h += '<div class=\\'ssh-field\\' id=\\'cfgKeyPassRow\\' style=\\'display:' + (authType==='key'?'block':'none') + '\\'><label>私钥口令</label><input id=\\'cfgKeyPassphrase\\' type=\\'password\\' placeholder=\\'留空则不修改\\'/></div>';"
html = html + "  h += '<div class=\\'ssh-field\\'><label>终端列</label><input id=\\'cfgCols\\' value=\\'' + esc(s.cols||120) + '\\'/></div>';"
html = html + "  h += '<div class=\\'ssh-field\\'><label>终端行</label><input id=\\'cfgRows\\' value=\\'' + esc(s.rows||40) + '\\'/></div>';"
html = html + "  h += '<div class=\\'ssh-field\\'><label>保活间隔(秒)</label><input id=\\'cfgKeepalive\\' value=\\'' + esc(s.keepalive!==undefined?s.keepalive:30) + '\\'/></div>';"
html = html + "  h += '<div style=\\'padding:8px 0;display:flex;gap:6px;flex-wrap:wrap\\'>';"
html = html + "  h += '<button class=\\'ssh-btn\\' onclick=\\'sshCfgApply()\\'>应用</button>';"
html = html + "  h += '<button class=\\'ssh-btn\\' onclick=\\'sshCfgTest()\\'>测试连接</button>';"
html = html + "  h += '<button class=\\'ssh-btn\\' onclick=\\'sshCfgActivate()\\'>设为激活</button>';"
html = html + "  h += '<button class=\\'ssh-btn\\' onclick=\\'sshCfgDelete()\\' style=\\'background:#c62828\\'>删除</button>';"
html = html + "  h += '</div>';"
html = html + "  h += '<div id=\\'cfgTestStatus\\' style=\\'padding:4px;font-size:12px;color:#888\\'></div>';"
html = html + "  h += '</div>';"
html = html + "  return h;"
html = html + "}"
html = html + "function sshCfgAuthChange() {"
html = html + "  var v = document.getElementById('cfgAuth').value;"
html = html + "  document.getElementById('cfgKeyRow').style.display = (v==='key')?'block':'none';"
html = html + "  document.getElementById('cfgKeyPassRow').style.display = (v==='key')?'block':'none';"
html = html + "}"
html = html + "// 应用：把表单值写回 cache\n"
html = html + "function sshCfgApply() {"
html = html + "  if (sshCfgCurIdx < 0) return;"
html = html + "  var s = sshCfgServersCache[sshCfgCurIdx];"
html = html + "  var oldName = s.name;"
html = html + "  s.name = document.getElementById('cfgName').value.trim() || ('server' + sshCfgCurIdx);"
html = html + "  // 重命名的正是当前激活服务器时，激活名跟随新名，避免激活指向不存在的名字\n"
html = html + "  if (oldName === sshCfgActiveCache) { sshCfgActiveCache = s.name; __sshActiveName = s.name; }"
html = html + "  s.host = document.getElementById('cfgHost').value.trim();"
html = html + "  s.port = parseInt(document.getElementById('cfgPort').value) || 22;"
html = html + "  s.user = document.getElementById('cfgUser').value.trim() || 'root';"
html = html + "  s.authType = document.getElementById('cfgAuth').value;"
html = html + "  var pw = document.getElementById('cfgPassword').value;"
html = html + "  if (pw) s.password = '__ENCRYPT_ME__' + pw;  // 留待后端加密\n"
html = html + "  s.keyPath = document.getElementById('cfgKeyPath').value.trim();"
html = html + "  var kp = document.getElementById('cfgKeyPassphrase').value;"
html = html + "  if (kp) s.keyPassphrase = '__ENCRYPT_ME__' + kp;"
html = html + "  s.cols = parseInt(document.getElementById('cfgCols').value) || 120;"
html = html + "  s.rows = parseInt(document.getElementById('cfgRows').value) || 40;"
html = html + "  s.keepalive = parseInt(document.getElementById('cfgKeepalive').value);"
html = html + "  if (isNaN(s.keepalive)) s.keepalive = 30;"
html = html + "  sshCfgRenderList(sshCfgServersCache, sshCfgActiveCache);"
html = html + "  sshCfgSelect(sshCfgCurIdx);"
html = html + "  document.getElementById('cfgTestStatus').textContent = '已应用（关闭弹窗时自动持久化）';"
html = html + "}"
html = html + "function sshCfgActivate() {"
html = html + "  if (sshCfgCurIdx < 0) return;"
html = html + "  sshCfgActiveCache = sshCfgServersCache[sshCfgCurIdx].name;"
html = html + "  __sshActiveName = sshCfgActiveCache;  // 前端即时生效；持久化在关闭弹窗时\n"
html = html + "  document.getElementById('cfgTestStatus').textContent = '已设为激活: ' + sshCfgActiveCache;"
html = html + "  sshCfgRenderList(sshCfgServersCache, sshCfgActiveCache);"
html = html + "  sshCfgSelect(sshCfgCurIdx);"
html = html + "}"
html = html + "function sshCfgDelete() {"
html = html + "  if (sshCfgCurIdx < 0) return;"
html = html + "  if (!confirm('删除服务器配置 \\'' + sshCfgServersCache[sshCfgCurIdx].name + '\\'?')) return;"
html = html + "  var removed = sshCfgServersCache.splice(sshCfgCurIdx, 1)[0];"
html = html + "  if (removed && removed.name === sshCfgActiveCache) { sshCfgActiveCache = ''; __sshActiveName = ''; }"
html = html + "  sshCfgCurIdx = -1;"
html = html + "  sshCfgRenderList(sshCfgServersCache, sshCfgActiveCache);"
html = html + "  document.getElementById('sshCfgForm').innerHTML = '请选择或新增服务器';"
html = html + "}"
html = html + "// 测试连接：先 Apply 把字段写回 cache，然后后端测试\n"
html = html + "function sshCfgTest() {"
html = html + "  if (sshCfgCurIdx < 0) return;"
html = html + "  sshCfgApply();"
html = html + "  // 临时保存以便后端能找到该 server 配置（包括刚输入的密码）\n"
html = html + "  sshCfgPersistAndTest(sshCfgServersCache[sshCfgCurIdx].name);"
html = html + "}"
html = html + "// 先持久化（让后端能读到最新配置），再发起测试\n"
html = html + "function sshCfgPersistAndTest(srvName) {"
html = html + "  var data = JSON.stringify(sshCfgServersCache) + String.fromCharCode(10) + sshCfgActiveCache;"
html = html + "  __sshTestPendingName = srvName;"
html = html + "  sshSend('SSHCFG_SAVE', data);"
html = html + "}"
html = html + "var __sshTestPendingName = '';"
html = html + "function sshCfgSaveResult(ok, msg) {"
html = html + "  if (!ok) { alert('保存失败: ' + msg); return; }"
html = html + "  // 如果有待测试的服务器，触发测试\n"
html = html + "  if (__sshTestPendingName) {"
html = html + "    var name = __sshTestPendingName; __sshTestPendingName = '';"
html = html + "    sshSend('SSHCFG_TEST', name);"
html = html + "    if (document.getElementById('cfgTestStatus')) document.getElementById('cfgTestStatus').textContent = '测试中...';"
html = html + "  }"
html = html + "}"
html = html + "function sshCfgTestResult(isError, msg) {"
html = html + "  var el = document.getElementById('cfgTestStatus');"
html = html + "  if (!el) { showOutput('SSH 测试: ' + msg, isError); return; }"
html = html + "  if (isError) {"
html = html + "    el.innerHTML = '<span style=\\'color:#f44747\\'>❌ ' + esc(msg) + '</span>';"
html = html + "  } else {"
html = html + "    // sshRun 成功返回 'echo __SSH_OK__' 的输出，应含 __SSH_OK__\n"
html = html + "    if (msg && msg.indexOf('__SSH_OK__') >= 0) {"
html = html + "      el.innerHTML = '<span style=\\'color:#4caf50\\'>✓ 连接成功</span>';"
html = html + "    } else {"
html = html + "      el.innerHTML = '<span style=\\'color:#4caf50\\'>✓ 连接成功: ' + esc(msg) + '</span>';"
html = html + "    }"
html = html + "  }"
html = html + "}"
html = html + "// 关闭配置弹窗前持久化\n"
html = html + "function sshCfgClose() {"
html = html + "  var data = JSON.stringify(sshCfgServersCache) + String.fromCharCode(10) + sshCfgActiveCache;"
html = html + "  sshSend('SSHCFG_SAVE', data);"
html = html + "  sshCloseDialog();"
html = html + "}"
html = html + "// ---- SSH 通用模态对话框基础设施 ----\n"
html = html + "// sshShowDialog 渲染全屏遮罩 + 居中弹窗。content 是 HTML 字符串。\n"
html = html + "// 同一时间只允许一个 SSH 弹窗（sshCloseDialog 关闭）。\n"
html = html + "function sshShowDialog(title, content, width, height) {"
html = html + "  sshCloseDialog();"
html = html + "  var overlay = document.createElement('div');"
html = html + "  overlay.id = 'sshOverlay';"
html = html + "  overlay.style.cssText = 'position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.5);z-index:1000;display:flex;align-items:center;justify-content:center;';"
html = html + "  var dlg = document.createElement('div');"
html = html + "  dlg.id = 'sshDialog';"
html = html + "  dlg.style.cssText = 'background:#1e1e1e;border:1px solid #505050;border-radius:6px;display:flex;flex-direction:column;max-width:95vw;max-height:95vh;width:' + (width||'80%') + ';height:' + (height||'80%') + ';box-shadow:0 8px 32px rgba(0,0,0,0.7);';"
html = html + "  var head = document.createElement('div');"
html = html + "  head.style.cssText = 'background:#252526;padding:8px 14px;border-bottom:1px solid #3c3c3c;display:flex;align-items:center;font-size:14px;color:#d4d4d4;flex-shrink:0;';"
html = html + "  head.innerHTML = '<span>' + esc(title||'SSH') + '</span><span style=\\'margin-left:auto;cursor:pointer;color:#888;padding:2px 8px\\' onclick=\\'sshCloseDialog()\\'>✕</span>';"
html = html + "  var body = document.createElement('div');"
html = html + "  body.id = 'sshDialogBody';"
html = html + "  body.style.cssText = 'flex:1;overflow:auto;padding:0;';"
html = html + "  body.innerHTML = content;"
html = html + "  dlg.appendChild(head); dlg.appendChild(body);"
html = html + "  overlay.appendChild(dlg);"
html = html + "  overlay.addEventListener('click', function(e) { if (e.target === overlay) sshCloseDialog(); });"
html = html + "  document.body.appendChild(overlay);"
html = html + "}"
html = html + "function sshCloseDialog() {"
html = html + "  var ov = document.getElementById('sshOverlay');"
html = html + "  if (ov) ov.remove();"
html = html + "}"
html = html + "// 无激活服务器时的友好提示\n"
html = html + "function sshNoActiveServer(op) {"
html = html + "  if (op === 'LIST') { var el = document.getElementById('sshBrowserList'); if (el) el.innerHTML = '<div class=\\'ssh-empty\\'>请先在\"服务器配置\"中激活一个服务器</div>'; }"
html = html + "  alert('请先在\"服务器配置\"中激活一个服务器');"
html = html + "}"
html = html + "// ---- SSH 文件浏览器 ----\n"
html = html + "function doSshBrowse() {"
html = html + "  sshBrowseShow('/');"
html = html + "}"
// 服务器下拉选项（当前激活的选中；数据来自后端注入/同步的 __sshServerNames）\n
html = html + "function sshServerSelOptionsHtml() {"
html = html + "  var h = '';"
html = html + "  for (var i = 0; i < __sshServerNames.length; i++) {"
html = html + "    var n = __sshServerNames[i];"
html = html + "    h += '<option value=\\'' + esc(n) + '\\'' + (n === __sshActiveName ? ' selected' : '') + '>' + esc(n) + '</option>';"
html = html + "  }"
html = html + "  return h;"
html = html + "}"
// 下拉切换：发 SSH_ACTIVATE，由后端持久化并回调 sshServerActivated\n
html = html + "function sshBrowserSwitchServer(name) {"
html = html + "  if (!name || name === __sshActiveName) return;"
html = html + "  var st = document.getElementById('sshBrowserStatus');"
html = html + "  if (st) st.textContent = '切换服务器: ' + name + ' ...';"
html = html + "  sshSend('SSH_ACTIVATE', name);"
html = html + "}"
// 激活切换结果：浏览器打开时重载根目录\n
html = html + "function sshServerActivated(ok, name) {"
html = html + "  var st = document.getElementById('sshBrowserStatus');"
html = html + "  if (!ok) { if (st) st.textContent = '激活失败: ' + name; return; }"
html = html + "  if (!document.getElementById('sshBrowserList')) return;  // 浏览器未打开时不请求列表\n"
html = html + "  if (st) st.textContent = '已激活: ' + name + '，加载 / ...';"
html = html + "  __sshBrowserState.cwd = '/';"
html = html + "  var pathEl = document.getElementById('sshBrowserPath');"
html = html + "  if (pathEl) pathEl.value = '/';"
html = html + "  sshBrowserRequestList('/');"
html = html + "}"
html = html + "// 打开浏览器弹窗（渲染骨架）并立即请求给定 cwd 的列表\n"
html = html + "function sshBrowseShow(cwd) {"
html = html + "  __sshBrowserState.cwd = cwd; __sshBrowserState.items = []; __sshBrowserState.selectedIdx = -1; __sshBrowserState.loading = true;"
html = html + "  var browserHtml = '<div class=\\'ssh-browser\\'>';"
html = html + "  browserHtml += '<div class=\\'ssh-browser-bar\\'>';"
html = html + "  browserHtml += '<select id=\\'sshServerSel\\' onchange=\\'sshBrowserSwitchServer(this.value)\\' title=\\'切换服务器（同时仅一个激活）\\' style=\\'max-width:110px;background:#3c3c3c;color:#d4d4d4;border:1px solid #505050;border-radius:3px;padding:4px;font-family:inherit;\\'>' + sshServerSelOptionsHtml() + '</select>';"
html = html + "  browserHtml += '<button class=\\'ssh-btn\\' onclick=\\'sshBrowserUp()\\'>↑ 上级</button>';"
html = html + "  browserHtml += '<input id=\\'sshBrowserPath\\' value=\\'' + esc(cwd) + '\\' onkeydown=\\'if(event.key===\\\"Enter\\\"){sshBrowserGoto(this.value);}\\'/>';"
html = html + "  browserHtml += '<button class=\\'ssh-btn\\' onclick=\\'sshBrowserRefresh()\\'>⟳ 刷新</button>';"
html = html + "  browserHtml += '<button class=\\'ssh-btn\\' onclick=\\'sshBrowserNewFile()\\'>📄 新建</button>';"
html = html + "  browserHtml += '<button class=\\'ssh-btn\\' onclick=\\'sshBrowserNewDir()\\'>📁 新建目录</button>';"
html = html + "  browserHtml += '</div>';"
html = html + "  browserHtml += '<div class=\\'ssh-browser-list\\' id=\\'sshBrowserList\\'><div class=\\'ssh-empty\\'>加载中...</div></div>';"
html = html + "  browserHtml += '<div style=\\'padding:6px 12px;border-top:1px solid #3c3c3c;font-size:12px;color:#888\\' id=\\'sshBrowserStatus\\'>就绪</div>';"
html = html + "  browserHtml += '</div>';"
html = html + "  sshShowDialog('SSH 文件浏览器 [' + (__sshActiveName || '未激活') + ']', browserHtml, '70%', '70%');"
html = html + "  sshBrowserRequestList(cwd);"
html = html + "}"
html = html + "// 请求目录列表（发 SSHOP\\nLIST\\npath）\n"
html = html + "function sshBrowserRequestList(path) {"
html = html + "  __sshBrowserState.loading = true;"
html = html + "  var statusEl = document.getElementById('sshBrowserStatus');"
html = html + "  if (statusEl) statusEl.textContent = '加载中: ' + path;"
html = html + "  sshSend('SSHOP', 'LIST' + String.fromCharCode(10) + path);"
html = html + "}"
html = html + "// LIST 结果回调\n"
html = html + "function sshListResult(resultJson, isError, path) {"
html = html + "  __sshBrowserState.loading = false;"
html = html + "  var listEl = document.getElementById('sshBrowserList');"
html = html + "  var statusEl = document.getElementById('sshBrowserStatus');"
html = html + "  if (!listEl) return;  // 弹窗已关闭\n"
html = html + "  if (isError) { listEl.innerHTML = '<div class=\\'ssh-empty\\'>❌ ' + esc(resultJson) + '</div>'; if (statusEl) statusEl.textContent = '错误'; return; }"
html = html + "  var items = [];"
html = html + "  try { items = (typeof resultJson === 'string') ? JSON.parse(resultJson || '[]') : (resultJson || []); } catch(e) { listEl.innerHTML = '<div class=\\'ssh-empty\\'>解析失败: ' + esc(e.message) + '</div>'; return; }"
html = html + "  __sshBrowserState.items = items; __sshBrowserState.cwd = path; __sshBrowserState.selectedIdx = -1;"
html = html + "  // 同步地址栏\n"
html = html + "  var pathEl = document.getElementById('sshBrowserPath'); if (pathEl) pathEl.value = path;"
html = html + "  if (items.length === 0) { listEl.innerHTML = '<div class=\\'ssh-empty\\'>(空目录)</div>'; if (statusEl) statusEl.textContent = path + ' (0 项)'; return; }"
html = html + "  // 先目录后文件，目录用 📁，文件用 📄，符号链接用 🔗\n"
html = html + "  var dirs = []; var files = [];"
html = html + "  for (var i = 0; i < items.length; i++) { var it = items[i]; if (it.isDir) dirs.push(it); else files.push(it); }"
html = html + "  var renderHtml = '';"
html = html + "  var renderOne = function(it) {"
html = html + "    var icon = it.isDir ? '📁' : (it.isSymlink ? '🔗' : '📄');"
html = html + "    var meta = it.isDir ? '' : sshFormatSize(it.size);"
html = html + "    var encoded = sshEncodePath(path, it.name);"
html = html + "    renderHtml += '<div class=\\'ssh-item\\' data-name=\\'' + esc(it.name) + '\\' data-fullpath=\\'' + esc(encoded) + '\\' data-isdir=\\'' + (it.isDir?1:0) + '\\' ondblclick=\\'sshBrowserDblClick(this)\\' onclick=\\'sshBrowserSelect(this)\\' oncontextmenu=\\'sshBrowserMenu(this,event);return false;\\'>';"
html = html + "    renderHtml += '<span class=\\'ssh-icon\\'>' + icon + '</span>';"
html = html + "    renderHtml += '<span class=\\'ssh-name\\'>' + esc(it.name) + '</span>';"
html = html + "    renderHtml += '<span class=\\'ssh-meta\\'>' + meta + '</span></div>';"
html = html + "  };"
html = html + "  for (var d = 0; d < dirs.length; d++) renderOne(dirs[d]);"
html = html + "  for (var f = 0; f < files.length; f++) renderOne(files[f]);"
html = html + "  listEl.innerHTML = renderHtml;"
html = html + "  if (statusEl) statusEl.textContent = path + ' (' + items.length + ' 项)';"
html = html + "}"
html = html + "// 拼接 path + name（处理尾斜杠）\n"
html = html + "function sshEncodePath(base, name) {"
html = html + "  if (base.endsWith('/')) return base + name;"
html = html + "  return base + '/' + name;"
html = html + "}"
html = html + "function sshFormatSize(bytes) {"
html = html + "  if (!bytes || bytes < 0) return '0 B';"
html = html + "  if (bytes < 1024) return bytes + ' B';"
html = html + "  if (bytes < 1024*1024) return (bytes/1024).toFixed(1) + ' KB';"
html = html + "  if (bytes < 1024*1024*1024) return (bytes/1024/1024).toFixed(1) + ' MB';"
html = html + "  return (bytes/1024/1024/1024).toFixed(2) + ' GB';"
html = html + "}"
html = html + "// 双击：目录进入，文件打开到编辑器\n"
html = html + "function sshBrowserDblClick(el) {"
html = html + "  var isDir = el.getAttribute('data-isdir') === '1';"
html = html + "  var full = el.getAttribute('data-fullpath');"
html = html + "  var name = el.getAttribute('data-name');"
html = html + "  if (isDir) { sshBrowserRequestList(full); }"
html = html + "  else { sshBrowserOpenFile(full, name); }"
html = html + "}"
html = html + "// 单击：选中\n"
html = html + "function sshBrowserSelect(el) {"
html = html + "  var all = document.querySelectorAll('.ssh-item');"
html = html + "  for (var i = 0; i < all.length; i++) all[i].classList.remove('selected');"
html = html + "  el.classList.add('selected');"
html = html + "  __sshBrowserState.selectedIdx = Array.prototype.indexOf.call(all, el);"
html = html + "}"
html = html + "// 右键菜单：打开/重命名/删除\n"
html = html + "function sshBrowserMenu(el, evt) {"
html = html + "  sshBrowserSelect(el);"
html = html + "  var isDir = el.getAttribute('data-isdir') === '1';"
html = html + "  var full = el.getAttribute('data-fullpath');"
html = html + "  var name = el.getAttribute('data-name');"
html = html + "  // 关掉已有菜单\n"
html = html + "  var old = document.getElementById('sshCtxtMenu'); if (old) old.remove();"
html = html + "  var m = document.createElement('div');"
html = html + "  m.id = 'sshCtxtMenu';"
html = html + "  m.style.cssText = 'position:fixed;background:#252526;border:1px solid #505050;border-radius:4px;z-index:2000;min-width:140px;box-shadow:4px 4px 12px rgba(0,0,0,0.7);';"
html = html + "  m.style.left = (evt.clientX || (window.event&&window.event.clientX) || 0) + 'px';"
html = html + "  m.style.top = (evt.clientY || (window.event&&window.event.clientY) || 0) + 'px';"
html = html + "  var addItem = function(label, fn, color) {"
html = html + "    var it = document.createElement('div');"
html = html + "    it.className = 'tpl-item';"
html = html + "    it.style.padding = '6px 14px';"
html = html + "    if (color) it.style.color = color;"
html = html + "    it.textContent = label;"
html = html + "    it.onclick = function() { fn(); m.remove(); };"
html = html + "    m.appendChild(it);"
html = html + "  };"
html = html + "  addItem(isDir ? '进入目录' : '打开文件', function() {"
html = html + "    if (isDir) sshBrowserRequestList(full); else sshBrowserOpenFile(full, name);"
html = html + "  });"
html = html + "  addItem('重命名', function() {"
html = html + "    var newName = prompt('重命名为:', name);"
html = html + "    if (newName && newName !== name) {"
html = html + "      var newFull = sshEncodePath(__sshBrowserState.cwd.replace(/\\/$/, ''), newName);"
html = html + "      sshSend('SSHOP', 'RENAME' + String.fromCharCode(10) + full + String.fromCharCode(10) + newFull);"
html = html + "      __sshBrowserState.renameFromRefresh = true;"
html = html + "    }"
html = html + "  });"
html = html + "  addItem('删除', function() {"
html = html + "    if (!confirm('删除 \\'' + name + '\\'?')) return;"
html = html + "    sshSend('SSHOP', 'DELETE' + String.fromCharCode(10) + full);"
html = html + "    __sshBrowserState.deleteFromRefresh = true;"
html = html + "  }, '#f44747');"
html = html + "  document.body.appendChild(m);"
html = html + "  // 点击其他地方关闭\n"
html = html + "  setTimeout(function() {"
html = html + "    var close = function(e) { if (!m.contains(e.target)) { m.remove(); document.removeEventListener('click', close); } };"
html = html + "    document.addEventListener('click', close);"
html = html + "  }, 50);"
html = html + "}"
html = html + "// 打开远程文件到编辑器（发 SSHOP\\nOPEN，异步回调 sshOpenResult）\n"
html = html + "function sshBrowserOpenFile(fullPath, name) {"
html = html + "  if (isDirty && !confirm('当前编辑器内容未保存，是否覆盖？')) return;"
html = html + "  sshSend('SSHOP', 'OPEN' + String.fromCharCode(10) + fullPath);"
html = html + "  __sshBrowserState.openingPath = fullPath;"
html = html + "  __sshBrowserState.openingName = name;"
html = html + "  var statusEl = document.getElementById('sshBrowserStatus');"
html = html + "  if (statusEl) statusEl.textContent = '下载中: ' + fullPath;"
html = html + "}"
html = html + "// OPEN 结果回调（resultJson 在 isError=false 时是 base64 字符串数组形式——其实后端会传 bytes 数组，前端要重组为字符串）\n"
html = html + "function sshOpenResult(resultJson, isError, path) {"
html = html + "  if (isError) {"
html = html + "    showOutput('打开远程文件失败: ' + resultJson, true);"
html = html + "    var statusEl = document.getElementById('sshBrowserStatus');"
html = html + "    if (statusEl) statusEl.textContent = '打开失败';"
html = html + "    return;"
html = html + "  }"
html = html + "  // 新协议：后端直接传字符串（strFromBytes 已解码）；兼容旧的数字数组格式\n"
html = html + "  var content = '';"
html = html + "  if (typeof resultJson === 'string') {"
html = html + "    content = resultJson;"
html = html + "  } else {"
html = html + "  var bytes = (resultJson || []);"
html = html + "  try {"
html = html + "    // bytes 是数字数组，转 string\n"
html = html + "    if (window.TextDecoder) { content = new TextDecoder('utf-8').decode(new Uint8Array(bytes)); }"
html = html + "    else { var CHUNK = 0x8000; var s = ''; for (var i = 0; i < bytes.length; i += CHUNK) { s += String.fromCharCode.apply(null, bytes.slice(i, i+CHUNK)); } content = decodeURIComponent(escape(s)); }"
html = html + "  } catch(e) { content = '(解码失败: ' + e.message + ')'; }"
html = html + "  }"
html = html + "  // 写入编辑器\n"
html = html + "  var ta = document.getElementById('editor');"
html = html + "  ta.value = content;"
html = html + "  onEdit(); setDirty(false);"
html = html + "  isRemoteFile = true;"
html = html + "  remotePathCurrent = path;"
html = html + "  currentFile = path;  // 兼容本地编辑器逻辑（显示标题等）\n"
html = html + "  currentServerName = sshCfgActiveCache || '';  // 取当前激活名做标题前缀\n"
html = html + "  __sshNewFilePendingPath = null;"
html = html + "  updateTitle();"
html = html + "  // 检测编码/换行符\n"
html = html + "  var hasCRLF = content.indexOf('\\r\\n') >= 0;"
html = html + "  if (hasCRLF) { content = content.replace(/\\r\\n/g, '\\n'); ta.value = content; onEdit(); lineEnding = 'CRLF'; leIdx = 1; } else { lineEnding = 'LF'; leIdx = 0; }"
html = html + "  document.getElementById('lineEndingInfo').textContent = lineEnding;"
html = html + "  fileEncoding = 'UTF-8'; encIdx = 0; document.getElementById('encodingInfo').textContent = 'UTF-8';"
html = html + "  document.getElementById('status').textContent = '已打开远程: ' + path;"
html = html + "  showOutput('已加载远程文件: ' + path, false);"
html = html + "  var statusEl = document.getElementById('sshBrowserStatus');"
html = html + "  if (statusEl) statusEl.textContent = '已加载: ' + path;"
html = html + "}"
html = html + "// 工具栏按钮\n"
html = html + "function sshBrowserUp() {"
html = html + "  var cwd = __sshBrowserState.cwd || '/';"
html = html + "  if (cwd === '/' || cwd === '') return;"
html = html + "  // 取上级目录\n"
html = html + "  var trimmed = cwd.replace(/\\/$/, '');"
html = html + "  var idx = trimmed.lastIndexOf('/');"
html = html + "  var parent = idx <= 0 ? '/' : trimmed.substring(0, idx);"
html = html + "  sshBrowserRequestList(parent);"
html = html + "}"
html = html + "function sshBrowserGoto(path) {"
html = html + "  if (!path) return;"
html = html + "  sshBrowserRequestList(path);"
html = html + "}"
html = html + "function sshBrowserRefresh() {"
html = html + "  sshBrowserRequestList(__sshBrowserState.cwd || '/');"
html = html + "}"
html = html + "function sshBrowserNewFile() {"
html = html + "  var name = prompt('新建文件名:');"
html = html + "  if (!name) return;"
html = html + "  var full = sshEncodePath(__sshBrowserState.cwd.replace(/\\/$/, ''), name);"
html = html + "  // 创建空文件：调 SSHOP SAVE with empty content\n"
html = html + "  __sshNewFilePendingPath = full;"
html = html + "  sshSend('SSHOP', 'SAVE' + String.fromCharCode(10) + full + String.fromCharCode(10) + '');"
html = html + "}"
html = html + "function sshBrowserNewDir() {"
html = html + "  var name = prompt('新建目录名:');"
html = html + "  if (!name) return;"
html = html + "  var full = sshEncodePath(__sshBrowserState.cwd.replace(/\\/$/, ''), name);"
html = html + "  sshSend('SSHOP', 'MKDIR' + String.fromCharCode(10) + full);"
html = html + "  __sshBrowserState.mkdirFromRefresh = true;"
html = html + "}"
html = html + "// SAVE / MKDIR / DELETE / RENAME 结果回调\n"
html = html + "function sshSaveResult(resultJson, isError, path) {"
html = html + "  if (isError) { showOutput('保存到远程失败: ' + resultJson, true); return; }"
html = html + "  showOutput('已保存到远程: ' + path, false);"
html = html + "  document.getElementById('status').textContent = '已保存: ' + path;"
html = html + "  isRemoteFile = true; remotePathCurrent = path; setDirty(false); updateTitle();"
html = html + "  // 若是浏览器新建文件触发，完成后打开到编辑器\n"
html = html + "  if (__sshNewFilePendingPath === path) {"
html = html + "    __sshNewFilePendingPath = null;"
html = html + "    // 清空编辑器等待新文件\n"
html = html + "    document.getElementById('editor').value = ''; onEdit(); setDirty(false);"
html = html + "    isRemoteFile = true; remotePathCurrent = path; currentFile = path;"
html = html + "    currentServerName = sshCfgActiveCache || ''; updateTitle();"
html = html + "  }"
html = html + "  // 若弹窗在开，刷新列表\n"
html = html + "  if (document.getElementById('sshBrowserList')) sshBrowserRefresh();"
html = html + "}"
html = html + "function sshMkdirResult(resultJson, isError, path) {"
html = html + "  if (isError) { showOutput('新建目录失败: ' + resultJson, true); return; }"
html = html + "  showOutput('已创建目录: ' + path, false);"
html = html + "  if (document.getElementById('sshBrowserList')) sshBrowserRefresh();"
html = html + "}"
html = html + "function sshDeleteResult(resultJson, isError, path) {"
html = html + "  if (isError) { showOutput('删除失败: ' + resultJson, true); return; }"
html = html + "  showOutput('已删除: ' + path, false);"
html = html + "  if (document.getElementById('sshBrowserList')) sshBrowserRefresh();"
html = html + "}"
html = html + "function sshRenameResult(resultJson, isError, path) {"
html = html + "  if (isError) { showOutput('重命名失败: ' + resultJson, true); return; }"
html = html + "  showOutput('已重命名: ' + path, false);"
html = html + "  if (document.getElementById('sshBrowserList')) sshBrowserRefresh();"
html = html + "}"
html = html + "// ---- 保存当前编辑器内容到远程 ----\n"
html = html + "// doSshSaveCurrent：保存到当前已打开的远程路径（isRemoteFile=true 时）\n"
html = html + "function doSshSaveCurrent() {"
html = html + "  if (!isRemoteFile || !remotePathCurrent) {"
html = html + "    alert('当前不是远程文件，请使用\"另存到远程\"');"
html = html + "    return;"
html = html + "  }"
html = html + "  __sshNewFilePendingPath = null;  // 防止触发新建文件回调\n"
html = html + "  var content = document.getElementById('editor').value;"
html = html + "  // 换行符按当前 lineEnding 设置转换\n"
html = html + "  if (lineEnding === 'CRLF') content = content.replace(/\\n/g, '\\r\\n');"
html = html + "  sshSend('SSHOP', 'SAVE' + String.fromCharCode(10) + remotePathCurrent + String.fromCharCode(10) + content);"
html = html + "}"
html = html + "// doSshSaveAs：另存到新路径（提示用户输入）\n"
html = html + "function doSshSaveAs() {"
html = html + "  var srvName = sshCfgActiveCache;"
html = html + "  if (!srvName) { alert('请先在\"服务器配置\"中激活一个服务器'); return; }"
html = html + "  var newPath = prompt('另存到远程路径 (例如 /tmp/newfile.sf):', remotePathCurrent || '/tmp/untitled.sf');"
html = html + "  if (!newPath) return;"
html = html + "  __sshNewFilePendingPath = null;"
html = html + "  var content = document.getElementById('editor').value;"
html = html + "  if (lineEnding === 'CRLF') content = content.replace(/\\n/g, '\\r\\n');"
html = html + "  sshSend('SSHOP', 'SAVE' + String.fromCharCode(10) + newPath + String.fromCharCode(10) + content);"
html = html + "}"
html = html + "// ---- SSH 终端（xterm.js）----\n"
html = html + "function doSshTerminal() {"
html = html + "  var srvName = __sshActiveName || sshCfgActiveCache;"
html = html + "  if (!srvName) { alert('请先在\"服务器配置\"中激活一个服务器，或在文件浏览器顶部的下拉中切换'); return; }"
html = html + "  __sshTermState.serverName = srvName;"
html = html + "  __sshTermState.closed = false;"
html = html + "  // 准备终端弹窗骨架\n"
html = html + "  var termHtml = '<div class=\\'ssh-term\\'>';"
html = html + "  termHtml += '<div class=\\'ssh-term-container\\' id=\\'sshTermContainer\\'></div>';"
html = html + "  termHtml += '<div class=\\'ssh-term-bar\\' id=\\'sshTermBar\\'><span id=\\'sshTermStatus\\'>连接中...</span><span style=\\'margin-left:auto\\'></span></div>';"
html = html + "  termHtml += '</div>';"
html = html + "  sshShowDialog('SSH 终端: ' + srvName, termHtml, '80%', '80%');"
html = html + "  // 第一次打开：先 LOADXTERM 拉资源，注入到 DOM 后再 init\n"
html = html + "  if (!window.Terminal) {"
html = html + "    window.__onXtermLoaded = function() {"
html = html + "      window.__onXtermLoaded = null;"
html = html + "      sshTermInit();"
html = html + "    };"
html = html + "    sshSend('LOADXTERM', '');"
html = html + "  } else {"
html = html + "    sshTermInit();"
html = html + "  }"
html = html + "}"
html = html + "// 注入 xterm 资源到 DOM（在 __onXtermLoaded 回调中调用）\n"
html = html + "// 后端通过 LOADXTERM 把 window.__xtermAssets 设置好\n"
html = html + "// 本函数由 doSshTerminal 直接调用（LOADXTERM 回调时也走同一函数）\n"
html = html + "function sshTermInjectAssets() {"
html = html + "  if (window.__xtermAssetsInjected) return true;"
html = html + "  var a = window.__xtermAssets; if (!a) return false;"
html = html + "  // 注入 CSS\n"
html = html + "  var style = document.createElement('style');"
html = html + "  style.id = 'xtermCss';"
html = html + "  style.textContent = a.css;"
html = html + "  document.head.appendChild(style);"
html = html + "  // 注入 xterm.js 主库\n"
html = html + "  var s1 = document.createElement('script');"
html = html + "  s1.textContent = a.js;"
html = html + "  document.body.appendChild(s1);"
html = html + "  // 注入 FitAddon\n"
html = html + "  var s2 = document.createElement('script');"
html = html + "  s2.textContent = a.fit;"
html = html + "  document.body.appendChild(s2);"
html = html + "  window.__xtermAssetsInjected = true;"
html = html + "  return true;"
html = html + "}"
html = html + "// 初始化 xterm Terminal 并发 SSHTTY_OPEN\n"
html = html + "function sshTermInit() {"
html = html + "  // 确保 assets 已注入（LOADXTERM 回调时已注入；后续重连时 window.Terminal 已存在）\n"
html = html + "  if (!window.Terminal) {"
html = html + "    if (!sshTermInjectAssets()) {"
html = html + "      var st = document.getElementById('sshTermStatus'); if (st) st.textContent = 'xterm 资源加载失败';"
html = html + "      return;"
html = html + "    }"
html = html + "  }"
html = html + "  var container = document.getElementById('sshTermContainer');"
html = html + "  if (!container) return;"
html = html + "  // 若已有 term 实例先销毁\n"
html = html + "  if (__sshTermState.term) { try { __sshTermState.term.dispose(); } catch(e){} __sshTermState.term = null; }"
html = html + "  __sshTermState.fitAddon = null;"
html = html + "  var term = new Terminal({ cursorBlink:true, fontSize:14, fontFamily:'Consolas, Monaco, Courier New, monospace', theme:{background:'#000', foreground:'#d4d4d4', cursor:'#fff'} });"
html = html + "  var fitAddon = new FitAddon.FitAddon();"
html = html + "  term.loadAddon(fitAddon);"
html = html + "  term.open(container);"
html = html + "  try { fitAddon.fit(); } catch(e){}"
html = html + "  __sshTermState.term = term;"
html = html + "  __sshTermState.fitAddon = fitAddon;"
html = html + "  // 用户输入 → SSHTTY_WRITE\n"
html = html + "  term.onData(function(data) {"
html = html + "    sshSend('SSHTTY_WRITE', data);"
html = html + "  });"
html = html + "  // 窗口大小变化 → SSHTTY_RESIZE\n"
html = html + "  term.onResize(function(size) {"
html = html + "    sshSend('SSHTTY_RESIZE', size.cols + String.fromCharCode(10) + size.rows);"
html = html + "  });"
html = html + "  // 监听容器尺寸变化（窗口 resize）\n"
html = html + "  if (!window.__sshTermResizeObserver) {"
html = html + "    window.__sshTermResizeObserver = new ResizeObserver(function() {"
html = html + "      if (__sshTermState.fitAddon && __sshTermState.term) { try { __sshTermState.fitAddon.fit(); } catch(e){} }"
html = html + "    });"
html = html + "  }"
html = html + "  window.__sshTermResizeObserver.observe(container);"
html = html + "  // 发起 SSH PTY 连接\n"
html = html + "  var st2 = document.getElementById('sshTermStatus'); if (st2) st2.textContent = '连接中: ' + __sshTermState.serverName;"
html = html + "  sshSend('SSHTTY_OPEN', __sshTermState.serverName);"
html = html + "}"
html = html + "// 后端 SSHTTY_OPEN 结果回调\n"
html = html + "function sshTtyOpenResult(streamId, ok, errMsg) {"
html = html + "  var statusEl = document.getElementById('sshTermStatus');"
html = html + "  if (!ok) {"
html = html + "    if (statusEl) statusEl.innerHTML = '<span style=\\'color:#f44747\\'>连接失败: ' + esc(errMsg||'') + '</span>';"
html = html + "    sshTermShowReconnect('连接失败: ' + (errMsg||''));"
html = html + "    return;"
html = html + "  }"
html = html + "  __sshTermState.streamId = streamId;"
html = html + "  __sshTermState.closed = false;"
html = html + "  if (statusEl) statusEl.innerHTML = '<span style=\\'color:#4caf50\\'>● 已连接 (streamId=' + streamId + ')</span>';"
html = html + "  // 移除断线重连提示\n"
html = html + "  var rb = document.getElementById('sshReconnectBar'); if (rb) rb.remove();"
html = html + "  if (__sshTermState.term) { __sshTermState.term.focus(); }"
html = html + "}"
html = html + "// 断线处理（onStreamData kindNum=1/2/3 触发）\n"
html = html + "function sshTtyOnDisconnect(reason) {"
html = html + "  if (__sshTermState.closed) return;  // 防止重复触发\n"
html = html + "  __sshTermState.closed = true;"
html = html + "  __sshTermState.streamId = 0;"
html = html + "  var statusEl = document.getElementById('sshTermStatus');"
html = html + "  if (statusEl) statusEl.innerHTML = '<span style=\\'color:#f44747\\'>● 断线: ' + esc(reason||'') + '</span>';"
html = html + "  sshTermShowReconnect(reason||'');"
html = html + "}"
html = html + "// 显示断线重连提示条\n"
html = html + "function sshTermShowReconnect(reason) {"
html = html + "  var bar = document.getElementById('sshReconnectBar');"
html = html + "  if (bar) bar.remove();"
html = html + "  var bar2 = document.createElement('div');"
html = html + "  bar2.id = 'sshReconnectBar';"
html = html + "  bar2.className = 'ssh-reconnect';"
html = html + "  bar2.style.margin = '0 8px';"
html = html + "  bar2.textContent = '⟳ 重连';"
html = html + "  bar2.title = '断线原因: ' + reason;"
html = html + "  bar2.onclick = function() {"
html = html + "    // 关闭旧的 session（后端会幂等处理）\n"
html = html + "    sshSend('SSHTTY_CLOSE', '');"
html = html + "    if (__sshTermState.term) { try { __sshTermState.term.clear(); __sshTermState.term.reset(); } catch(e){} }"
html = html + "    __sshTermState.closed = false;"
html = html + "    bar2.remove();"
html = html + "    sshTermInit();  // 重新建连\n"
html = html + "  };"
html = html + "  var termBar = document.getElementById('sshTermBar');"
html = html + "  if (termBar) termBar.appendChild(bar2);"
html = html + "}"
html = html + "// 弹窗关闭时（点✕或遮罩）会调 sshCloseDialog；这里挂钩关闭前的清理\n"
html = html + "var __sshOrigCloseDialog = sshCloseDialog;"
html = html + "sshCloseDialog = function() {"
html = html + "  // 若是终端弹窗关闭，主动断开 SSH PTY\n"
html = html + "  if (__sshTermState.term) {"
html = html + "    sshSend('SSHTTY_CLOSE', '');"
html = html + "    try { __sshTermState.term.dispose(); } catch(e){}"
html = html + "    __sshTermState.term = null; __sshTermState.fitAddon = null; __sshTermState.streamId = 0; __sshTermState.closed = true;"
html = html + "  }"
html = html + "  __sshOrigCloseDialog();"
html = html + "};"

// 初始化
html = html + "window.onload = function() {"
html = html + "  toggleWrap(); toggleWrap();"
html = html + "  onEdit();"
html = html + "  setDirty(false);"
html = html + "  document.getElementById('editor').focus();"
html = html + "};"

html = html + "</script>"
// 调试模式：在主 JS 之后注入回调包装。
// 后端通过 window.onAsyncResult / window.onStreamData 直接推送结果，
// 不经过 onMessage，此前的 --debug 日志看不到这个方向的数据与异常；
// 包装后每次回调的参数（类型+预览）都会以 JSLOG 回传进调试日志，
// 回调内部的异常也会进入 onerror（红色调试条 + JSERR 日志）。
if debugMode {
    html = html + "<script>"
    html = html + "(function() {"
    html = html + "  function jslog(m) { try { window.ipc.postMessage('JSLOG' + String.fromCharCode(10) + String(m).substring(0, 200)); } catch(e) {} }"
    html = html + "  function wrap(name) {"
    html = html + "    var f = window[name];"
    html = html + "    if (typeof f !== 'function') return;"
    html = html + "    window[name] = function(a, b, c) {"
    html = html + "      jslog(name + '(' + a + (c ? ', ERR' : '') + ') ' + typeof b + ' : ' + String(b).substring(0, 120));"
    html = html + "      try { return f(a, b, c); }"
    html = html + "      catch(e) { try { window.onerror(name + ' 回调异常: ' + e.message, '(callback)', 0, 0); } catch(e2) {} }"
    html = html + "    };"
    html = html + "  }"
    html = html + "  wrap('onAsyncResult'); wrap('onStreamData');"
    html = html + "  jslog('回调包装完成 onAsyncResult=' + typeof window.onAsyncResult + ' onStreamData=' + typeof window.onStreamData);"
    html = html + "})();"
    html = html + "</script>"
}
html = html + "</html>"

// ---- 创建窗口 ----
var win = guiNewWindow("--title=Sflang 代码编辑器", "--width=1100", "--height=750")
win = guiSetHtml(win, html)
win = guiSetHandler(win, onMessage)

// 如果有命令行参数指定的文件，加载它
if initFile != "" && fileExists(initFile) {
    var initContent = readFile(initFile)
    // 延迟执行：在 guiShow 之前无法执行 guiEval，所以通过初始 HTML 内嵌
    // 改为在 HTML 的 onload 中检查全局变量
    // 简单方案：把初始内容编码到 HTML 中
    html = strReplace(html, "window.onload = function() {",
        "window.onload = function() { document.getElementById('editor').value = '" + escapeJS(initContent) + "'; document.getElementById('filename').textContent = '" + escapeJS(initFile) + "';")
    win = guiSetHtml(win, html)
}

dbg("窗口已创建，即将进入 guiShow 事件循环（关闭窗口后才会返回）")
guiShow(win)
dbg("事件循环结束，窗口已关闭")
